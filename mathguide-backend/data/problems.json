[
  {
    "id": "p01",
    "text": "求极限: lim_{n→∞} n·(1 - cos(1/n))",
    "difficulty": 2,
    "min_prereq_mastery": {
      "limit_intuitive": 0.5,
      "infinitesimals": 0.5,
      "limit_rules": 0.5
    },
    "tags": [
      "极限",
      "夹逼"
    ],
    "steps": [
      {
        "id": "p01_s1",
        "text": "将 n·(1-cos(1/n)) 改写为 (1-cos(1/n))/(1/n), 令 x=1/n",
        "node_id": "limit_intuitive",
        "dim_id": "func_limits_intuit",
        "prerequisite_steps": [],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "fail_form",
            "desc": "没能将乘积形式改写为分式",
            "dim_affected": "func_limits_intuit"
          }
        ]
      },
      {
        "id": "p01_s2",
        "text": "使用等价无穷小: 1-cosx ~ x²/2, 得原式 ~ x/2 = 1/(2n)",
        "node_id": "infinitesimals",
        "dim_id": "equiv_infinitesimal",
        "prerequisite_steps": [
          "p01_s1"
        ],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "wrong_equiv",
            "desc": "不知道或记错了1-cosx的等价形式",
            "dim_affected": "equiv_infinitesimal"
          },
          {
            "pattern": "order_wrong",
            "desc": "展开阶数不够，忽略高阶无穷小处理",
            "dim_affected": "infinitesimal_order"
          }
        ]
      },
      {
        "id": "p01_s3",
        "text": "求极限: lim_{n→∞} 1/(2n) = 0",
        "node_id": "limit_rules",
        "dim_id": "limit_basic_ops",
        "prerequisite_steps": [
          "p01_s2"
        ],
        "difficulty": 1,
        "novelty": 1,
        "error_patterns": [
          {
            "pattern": "missing_limit",
            "desc": "不会取极限/忘记n→∞的条件",
            "dim_affected": "limit_basic_ops"
          }
        ]
      }
    ]
  },
  {
    "id": "p02",
    "text": "求极限: lim_{x→0} (e^x - 1 - x) / x²",
    "difficulty": 3,
    "min_prereq_mastery": {
      "lhopital": 0.5,
      "infinitesimals": 0.5
    },
    "tags": [
      "极限",
      "洛必达"
    ],
    "steps": [
      {
        "id": "p02_s1",
        "text": "代入 x=0 判断型: 分子→0, 分母→0, 确认是0/0型",
        "node_id": "lhopital",
        "dim_id": "lhopital_recognition",
        "prerequisite_steps": [],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "no_verify",
            "desc": "没有先验证极限类型就使用洛必达",
            "dim_affected": "lhopital_recognition"
          }
        ]
      },
      {
        "id": "p02_s2",
        "text": "第一次洛必达: 分子求导得 e^x - 1, 分母求导得 2x",
        "node_id": "lhopital",
        "dim_id": "lhopital_multi",
        "prerequisite_steps": [
          "p02_s1"
        ],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "diff_wrong",
            "desc": "e^x - 1 - x 求导错误",
            "dim_affected": "basic_diff_table"
          }
        ]
      },
      {
        "id": "p02_s3",
        "text": "再次代入判断: 仍然是0/0型。第二次洛必达: 分子 e^x, 分母 2",
        "node_id": "lhopital",
        "dim_id": "lhopital_multi",
        "prerequisite_steps": [
          "p02_s2"
        ],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "stop_early",
            "desc": "一次洛必达后没检查是否仍为0/0型就停了",
            "dim_affected": "lhopital_multi"
          }
        ]
      },
      {
        "id": "p02_s4",
        "text": "取极限: lim_{x→0} e^x / 2 = 1/2",
        "node_id": "limit_rules",
        "dim_id": "limit_basic_ops",
        "prerequisite_steps": [
          "p02_s3"
        ],
        "difficulty": 1,
        "novelty": 1,
        "error_patterns": []
      }
    ]
  },
  {
    "id": "p03",
    "text": "用导数定义求 f(x) = x² 在 x=2 处的导数",
    "difficulty": 2,
    "min_prereq_mastery": {
      "derivative_def": 0.5,
      "limit_rules": 0.5
    },
    "tags": [
      "导数",
      "定义"
    ],
    "steps": [
      {
        "id": "p03_s1",
        "text": "写出差商: (f(2+h)-f(2))/h = ((2+h)² - 4)/h",
        "node_id": "derivative_def",
        "dim_id": "derivative_delta",
        "prerequisite_steps": [],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "wrong_formula",
            "desc": "记错了导数定义的差商形式",
            "dim_affected": "derivative_delta"
          }
        ]
      },
      {
        "id": "p03_s2",
        "text": "展开分子: (4+4h+h²-4)/h = (4h+h²)/h = 4+h",
        "node_id": "diff_rules",
        "dim_id": "basic_diff_table",
        "prerequisite_steps": [
          "p03_s1"
        ],
        "difficulty": 1,
        "novelty": 1,
        "error_patterns": [
          {
            "pattern": "expand_wrong",
            "desc": "展开(2+h)²时出错",
            "dim_affected": "basic_diff_table"
          }
        ]
      },
      {
        "id": "p03_s3",
        "text": "取极限: lim_{h→0} (4+h) = 4",
        "node_id": "limit_rules",
        "dim_id": "limit_basic_ops",
        "prerequisite_steps": [
          "p03_s2"
        ],
        "difficulty": 1,
        "novelty": 1,
        "error_patterns": []
      }
    ]
  },
  {
    "id": "p04",
    "text": "求导: y = ln(sin(e^x))",
    "difficulty": 3,
    "min_prereq_mastery": {
      "chain_rule": 0.5,
      "diff_rules": 0.5,
      "elementary_functions": 0.5
    },
    "tags": [
      "导数",
      "链式法则"
    ],
    "steps": [
      {
        "id": "p04_s1",
        "text": "从外到内分解: y = ln(u), u = sin(v), v = e^x",
        "node_id": "chain_rule",
        "dim_id": "chain_decompose",
        "prerequisite_steps": [],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "decompose_fail",
            "desc": "不能正确分解多层复合函数",
            "dim_affected": "chain_decompose"
          },
          {
            "pattern": "wrong_order",
            "desc": "分解顺序颠倒(误把外层当内层)",
            "dim_affected": "compose_basics"
          }
        ]
      },
      {
        "id": "p04_s2",
        "text": "逐层求导: dy/du = 1/u, du/dv = cos(v), dv/dx = e^x",
        "node_id": "chain_rule",
        "dim_id": "chain_decompose",
        "prerequisite_steps": [
          "p04_s1"
        ],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "diff_ln",
            "desc": "ln求导公式记错",
            "dim_affected": "basic_diff_table"
          },
          {
            "pattern": "diff_sin",
            "desc": "sin求导变cos还是-cos记混",
            "dim_affected": "trig_functions"
          }
        ]
      },
      {
        "id": "p04_s3",
        "text": "链式相乘: dy/dx = 1/sin(e^x) · cos(e^x) · e^x",
        "node_id": "chain_rule",
        "dim_id": "chain_decompose",
        "prerequisite_steps": [
          "p04_s2"
        ],
        "difficulty": 3,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "chain_omit",
            "desc": "漏乘了某层导数（常见：只乘了两层）",
            "dim_affected": "chain_decompose"
          }
        ]
      }
    ]
  },
  {
    "id": "p05",
    "text": "已知 y² + 2xy = 1, 求 dy/dx 在 (1, -1) 处的值",
    "difficulty": 3,
    "min_prereq_mastery": {
      "implicit_param": 0.5
    },
    "tags": [
      "导数",
      "隐函数"
    ],
    "steps": [
      {
        "id": "p05_s1",
        "text": "两边对x求导: 2y·y' + 2y + 2x·y' = 0",
        "node_id": "implicit_param",
        "dim_id": "implicit_diff",
        "prerequisite_steps": [],
        "difficulty": 3,
        "novelty": 3,
        "error_patterns": [
          {
            "pattern": "prod_miss",
            "desc": "没把2xy看成乘积形式（忘用乘法法则）",
            "dim_affected": "implicit_diff"
          },
          {
            "pattern": "y_as_const",
            "desc": "求导时把y当常数处理了",
            "dim_affected": "implicit_diff"
          }
        ]
      },
      {
        "id": "p05_s2",
        "text": "整理含 y' 的项: (2y+2x)·y' = -2y",
        "node_id": "diff_rules",
        "dim_id": "prod_quo_rule",
        "prerequisite_steps": [
          "p05_s1"
        ],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": []
      },
      {
        "id": "p05_s3",
        "text": "解出 y': y' = -2y/(2y+2x) = -y/(y+x)",
        "node_id": "diff_rules",
        "dim_id": "basic_diff_table",
        "prerequisite_steps": [
          "p05_s2"
        ],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": []
      },
      {
        "id": "p05_s4",
        "text": "代入 (1, -1): y' = -(-1)/((-1)+1) = 1/0, 无定义→检查",
        "node_id": "implicit_param",
        "dim_id": "implicit_diff",
        "prerequisite_steps": [
          "p05_s3"
        ],
        "difficulty": 3,
        "novelty": 4,
        "error_patterns": [
          {
            "pattern": "no_check",
            "desc": "代入后分母为零却没意识到不可导",
            "dim_affected": "implicit_diff"
          }
        ]
      }
    ]
  },
  {
    "id": "p06",
    "text": "证明: 当 a > b > 0 时, (a-b)/a < ln(a/b) < (a-b)/b",
    "difficulty": 4,
    "min_prereq_mastery": {
      "mean_value_theorems": 0.5,
      "derivative_inequality": 0.5
    },
    "tags": [
      "中值定理",
      "不等式"
    ],
    "steps": [
      {
        "id": "p06_s1",
        "text": "构造函数 f(x)=lnx, 在区间[b,a]上用拉格朗日中值定理",
        "node_id": "mean_value_theorems",
        "dim_id": "lagrange_mvt",
        "prerequisite_steps": [],
        "difficulty": 4,
        "novelty": 4,
        "error_patterns": [
          {
            "pattern": "no_func_construct",
            "desc": "不知道该对哪个函数用中值定理",
            "dim_affected": "mvt_func_construction"
          }
        ]
      },
      {
        "id": "p06_s2",
        "text": "由中值定理: ln(a)-ln(b) = (a-b)/ξ, 其中 ξ∈(b,a)",
        "node_id": "mean_value_theorems",
        "dim_id": "lagrange_mvt",
        "prerequisite_steps": [
          "p06_s1"
        ],
        "difficulty": 3,
        "novelty": 3,
        "error_patterns": [
          {
            "pattern": "mv_formula_wrong",
            "desc": "拉格朗日中值公式写错",
            "dim_affected": "lagrange_mvt"
          }
        ]
      },
      {
        "id": "p06_s3",
        "text": "由 b < ξ < a, 得 1/a < 1/ξ < 1/b",
        "node_id": "derivative_inequality",
        "dim_id": "inequality_construction",
        "prerequisite_steps": [
          "p06_s2"
        ],
        "difficulty": 3,
        "novelty": 3,
        "error_patterns": [
          {
            "pattern": "ineq_dir_wrong",
            "desc": "不等号方向反了(ξ大→1/ξ小)",
            "dim_affected": "inequality_construction"
          }
        ]
      },
      {
        "id": "p06_s4",
        "text": "代入中值定理的等式: (a-b)/a < ln(a)-ln(b) < (a-b)/b",
        "node_id": "derivative_inequality",
        "dim_id": "inequality_construction",
        "prerequisite_steps": [
          "p06_s3"
        ],
        "difficulty": 3,
        "novelty": 4,
        "error_patterns": [
          {
            "pattern": "chain_break",
            "desc": "没把放缩结果与中值定理的等式连接起来",
            "dim_affected": "inequality_construction"
          }
        ]
      }
    ]
  },
  {
    "id": "p07",
    "text": "求极限: lim_{x→0} (sinx - x) / x³",
    "difficulty": 3,
    "min_prereq_mastery": {
      "taylor_formula": 0.5
    },
    "tags": [
      "极限",
      "泰勒"
    ],
    "steps": [
      {
        "id": "p07_s1",
        "text": "识别为 0/0 型, 考虑用泰勒展开代替洛必达",
        "node_id": "taylor_formula",
        "dim_id": "taylor_limit",
        "prerequisite_steps": [],
        "difficulty": 2,
        "novelty": 3,
        "error_patterns": [
          {
            "pattern": "no_strategy",
            "desc": "不知道什么时候用泰勒比洛必达更方便",
            "dim_affected": "taylor_limit"
          }
        ]
      },
      {
        "id": "p07_s2",
        "text": "展开 sinx = x - x³/3! + o(x³)",
        "node_id": "taylor_formula",
        "dim_id": "taylor_expand",
        "prerequisite_steps": [
          "p07_s1"
        ],
        "difficulty": 3,
        "novelty": 3,
        "error_patterns": [
          {
            "pattern": "expand_wrong",
            "desc": "sinx的泰勒展开项数或符号记错",
            "dim_affected": "taylor_expand"
          }
        ]
      },
      {
        "id": "p07_s3",
        "text": "代入原式: (x - x³/6 + o(x³) - x) / x³ = (-x³/6 + o(x³)) / x³",
        "node_id": "taylor_formula",
        "dim_id": "taylor_limit",
        "prerequisite_steps": [
          "p07_s2"
        ],
        "difficulty": 3,
        "novelty": 3,
        "error_patterns": [
          {
            "pattern": "order_insufficient",
            "desc": "展开阶数不够(没展开到x³项以上)",
            "dim_affected": "taylor_limit"
          }
        ]
      },
      {
        "id": "p07_s4",
        "text": "取极限: -1/6",
        "node_id": "limit_rules",
        "dim_id": "limit_basic_ops",
        "prerequisite_steps": [
          "p07_s3"
        ],
        "difficulty": 1,
        "novelty": 1,
        "error_patterns": []
      }
    ]
  },
  {
    "id": "p08",
    "text": "证明: 当 x > 0 时, e^x > 1 + x",
    "difficulty": 3,
    "min_prereq_mastery": {
      "monotonicity_extrema": 0.5,
      "derivative_inequality": 0.5
    },
    "tags": [
      "不等式",
      "导数"
    ],
    "steps": [
      {
        "id": "p08_s1",
        "text": "构造辅助函数 f(x) = e^x - 1 - x",
        "node_id": "derivative_inequality",
        "dim_id": "inequality_construction",
        "prerequisite_steps": [],
        "difficulty": 3,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "no_construction",
            "desc": "不知道移项构造辅助函数的方法",
            "dim_affected": "inequality_construction"
          }
        ]
      },
      {
        "id": "p08_s2",
        "text": "求导: f'(x) = e^x - 1",
        "node_id": "diff_rules",
        "dim_id": "basic_diff_table",
        "prerequisite_steps": [
          "p08_s1"
        ],
        "difficulty": 1,
        "novelty": 1,
        "error_patterns": []
      },
      {
        "id": "p08_s3",
        "text": "判断符号: x>0 时 e^x > 1, 所以 f'(x) > 0, f(x) 单调递增",
        "node_id": "monotonicity_extrema",
        "dim_id": "monotonic_judge",
        "prerequisite_steps": [
          "p08_s2"
        ],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "sign_wrong",
            "desc": "e^x与1比较时误判了符号",
            "dim_affected": "monotonic_judge"
          }
        ]
      },
      {
        "id": "p08_s4",
        "text": "由 f(0) = 0 且 f 单调增, 得 x>0 时 f(x) > 0 → e^x > 1+x",
        "node_id": "derivative_inequality",
        "dim_id": "inequality_construction",
        "prerequisite_steps": [
          "p08_s3"
        ],
        "difficulty": 3,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "chain_break",
            "desc": "没把单调性和端点值结合来证明不等式",
            "dim_affected": "inequality_construction"
          }
        ]
      }
    ]
  },
  {
    "id": "p09",
    "text": "求积分: ∫ x·e^{x²} dx",
    "difficulty": 2,
    "min_prereq_mastery": {
      "substitution_1": 0.5
    },
    "tags": [
      "积分",
      "换元"
    ],
    "steps": [
      {
        "id": "p09_s1",
        "text": "识别复合结构: 内函数 u=x², 其导数 du=2x·dx 在外部(缺系数2)",
        "node_id": "substitution_1",
        "dim_id": "u_substitution_detect",
        "prerequisite_steps": [],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "no_pattern",
            "desc": "没看出x²的导数2x已经出现在外面",
            "dim_affected": "u_substitution_detect"
          }
        ]
      },
      {
        "id": "p09_s2",
        "text": "补系数: ∫ x·e^{x²} dx = ½∫ e^{x²}·2x·dx = ½∫ e^u du",
        "node_id": "substitution_1",
        "dim_id": "inner_diff_extract",
        "prerequisite_steps": [
          "p09_s1"
        ],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "coeff_wrong",
            "desc": "补系数时乘除颠倒了",
            "dim_affected": "inner_diff_extract"
          }
        ]
      },
      {
        "id": "p09_s3",
        "text": "积分: ½·e^u + C = ½·e^{x²} + C",
        "node_id": "substitution_1",
        "dim_id": "inner_diff_extract",
        "prerequisite_steps": [
          "p09_s2"
        ],
        "difficulty": 2,
        "novelty": 2,
        "error_patterns": [
          {
            "pattern": "forget_C",
            "desc": "忘了加积分常数+C",
            "dim_affected": "indefinite_concept"
          }
        ]
      }
    ]
  },
  {
    "id": "p10",
    "text": "求积分: ∫ 1/√(1-x²) dx",
    "difficulty": 3,
    "min_prereq_mastery": {
      "substitution_2": 0.5
    },
    "tags": [
      "积分",
      "三角换元"
    ],
    "steps": [
      {
        "id": "p10_s1",
        "text": "识别 √(1-x²) 模式 → 三角替换 x=sint, dx=cost·dt",
        "node_id": "substitution_2",
        "dim_id": "trig_substitution",
        "prerequisite_steps": [],
        "difficulty": 3,
        "novelty": 3,
        "error_patterns": [
          {
            "pattern": "wrong_sub",
            "desc": "选择了错误的换元(如x=tant)",
            "dim_affected": "trig_substitution"
          },
          {
            "pattern": "no_recognition",
            "desc": "没认出√(a²-x²)的三角替换模式",
            "dim_affected": "trig_substitution"
          }
        ]
      },
      {
        "id": "p10_s2",
        "text": "代入: ∫ 1/√(1-sin²t) · cost·dt = ∫ cost/cost·dt = ∫ 1·dt",
        "node_id": "substitution_2",
        "dim_id": "trig_substitution",
        "prerequisite_steps": [
          "p10_s1"
        ],
        "difficulty": 3,
        "novelty": 3,
        "error_patterns": [
          {
            "pattern": "root_simplify",
            "desc": "√(1-sin²t)=|cost| 的正负讨论漏了",
            "dim_affected": "trig_substitution"
          }
        ]
      },
      {
        "id": "p10_s3",
        "text": "积分 = t + C = arcsinx + C",
        "node_id": "substitution_2",
